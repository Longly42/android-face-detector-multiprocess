<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 声明相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 声明应用需要相机硬件（非强制） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".FaceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="AndroidFaceDetector"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidFaceDetector">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="AndroidFaceDetector"
            android:theme="@style/Theme.AndroidFaceDetector"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          独立推理进程：android:process=":inference"
          该进程只跑模型与特征库，通过 AIDL 与主进程通信。
        -->
        <service
            android:name=".inference.InferenceService"
            android:exported="false"
            android:process=":inference" />
    </application>

</manifest>